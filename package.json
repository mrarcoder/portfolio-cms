{
  "name": "portfolio-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrarcoder/portfolio-cms.git"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "db:migrate": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir .worker-build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "wrangler": "4.129.0"
  }
}
