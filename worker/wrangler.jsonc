{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "portfolio-cms-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "vars": { "FRONTEND_ORIGIN": "https://mrarcoder.vercel.app" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "portfolio-cms",
    "database_id": "8f637e26-9084-4711-a7f2-6d35198acf87",
    "migrations_dir": "../database/migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portfolio-cms-media" }]
}
